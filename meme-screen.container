[Unit]
Description=Meme Screen
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/meme-screen:latest
ContainerName=meme-screen
Environment=DISPLAY=:0
EnvironmentFile=%h/meme-screen/config.env
Volume=/tmp/.X11-unix:/tmp/.X11-unix:rw
Volume=%h/meme-screen/config.env:/app/.env:ro
Volume=%h/meme-screen/pictures:/tmp/meme-screen/pictures
AddDevice=/dev/dri
AddDevice=/dev/fb0
PodmanArgs=--privileged --userns=keep-id

[Service]
ExecStartPre=/bin/bash -c 'pkill -x Xorg 2>/dev/null; sleep 1; /usr/bin/Xorg :0 vt2 -nolisten tcp -ac &>/dev/null & sleep 3'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
